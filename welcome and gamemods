# ------------------------------------------------------------------------------
# GAME CLASSES (HIT CIRCLES FOR BOTH MODES)
# ------------------------------------------------------------------------------
class HitCircle:
    def __init__(self):
        self.x = random.randint(150, SCREEN_WIDTH - 150)
        self.y = random.randint(150, SCREEN_HEIGHT - 150)
        self.radius = circle_radius
        self.alive = True
        
        if game_mode == "STANDARD":
            self.approach_scale = 3.0
            self.approach_speed = approach_speed
        elif game_mode == "DIVA":
            angle = random.uniform(0, 2 * math.pi)
            self.start_dist = 200
            self.current_dist = self.start_dist
            self.fly_speed = approach_speed * 120  # Scale speed for coordinate translation
            
    def update(self):
        if game_mode == "STANDARD":
            self.approach_scale -= self.approach_speed
            if self.approach_scale <= 1.0:
                self.alive = False
                return False
        elif game_mode == "DIVA":
            self.current_dist -= self.fly_speed
            if self.current_dist <= 0:
                self.alive = False
                return False
        return True

    def draw(self, surface):
        if not self.alive:
            return
            
        if game_mode == "STANDARD":
            current_approach_radius = int(self.radius * self.approach_scale)
            pygame.draw.circle(surface, APPROACH_COLOR, (self.x, self.y), current_approach_radius, 2)
            pygame.draw.circle(surface, CIRCLE_COLOR, (self.x, self.y), self.radius)
            
        elif game_mode == "DIVA":
            # Target silhouette
            pygame.draw.circle(surface, (60, 60, 70), (self.x, self.y), self.radius, 2)
            # Moving flying note element (Approaching target point)
            note_x = int(self.x + math.cos(self.current_dist * 0.05) * self.current_dist)
            note_y = int(self.y + math.sin(self.current_dist * 0.05) * self.current_dist)
            pygame.draw.circle(surface, DIVA_COLOR, (note_x, note_y), int(self.radius * 0.8))

    def check_click(self, mouse_pos):
        if game_mode == "STANDARD":
            distance = math.hypot(self.x - mouse_pos[0], self.y - mouse_pos[1])
            if distance <= self.radius:
                if 1.0 <= self.approach_scale <= 1.5: return "HIT"
                else: return "BAD_TIMING"
        elif game_mode == "DIVA":
            distance = math.hypot(self.x - mouse_pos[0], self.y - mouse_pos[1])
            if distance <= self.radius:
                if 0 <= self.current_dist <= 25: return "HIT"
                else: return "BAD_TIMING"
        return "MISS"

# Setup entity lists
circles = []
spawn_timer = 0
spawn_rate = 60
welcome_timer = 0

# Main Game Loop
running = True
while running:
    mouse_pos = pygame.mouse.get_pos()
    
    # ==========================================================================
    # 1. STATE: WELCOME INTRO SCREEN
    # ==========================================================================
    if game_state == "WELCOME":
        screen.fill(BACKGROUND)
        play_welcome_voice()
        
        welcome_timer += 1
        # Pulsing logo size scale calculation
        pulse = int(math.sin(welcome_timer * 0.1) * 10)
        pulsed_img = pygame.transform.scale(ucup_img, (180 + pulse, 180 + pulse))
        
        screen.blit(pulsed_img, (SCREEN_WIDTH // 2 - pulsed_img.get_width() // 2, SCREEN_HEIGHT // 2 - 140))
        w_text = title_font.render("UCUP OFS", True, CIRCLE_COLOR)
        h_text = font.render("Press ANY KEY to Continue", True, TEXT_COLOR)
        
        screen.blit(w_text, (SCREEN_WIDTH // 2 - w_text.get_width() // 2, SCREEN_HEIGHT // 2 + 80))
        screen.blit(h_text, (SCREEN_WIDTH // 2 - h_text.get_width() // 2, SCREEN_HEIGHT // 2 + 160))
        
        for event in pygame.event.get():
            if event.type == pygame.QUIT: running = False
            elif event.type in [pygame.KEYDOWN, pygame.MOUSEBUTTONDOWN]:
                game_state = "MODE_SELECT"

    # ==========================================================================
    # 2. STATE: GAME MODES SELECT
    # ==========================================================================
    elif game_state == "MODE_SELECT":
        screen.fill(MENU_BG)
        m_title = title_font.render("SELECT GAME MODE", True, ACCENT_COLOR)
        screen.blit(m_title, (SCREEN_WIDTH // 2 - m_title.get_width() // 2, 80))
        
        # Mode Selection Boxes
        pygame.draw.rect(screen, (30, 20, 40), (120, 220, 240, 180), border_radius=10)
        pygame.draw.rect(screen, (20, 35, 50), (440, 220, 240, 180), border_radius=10)
        
        lbl_std = font.render(" [1] OSU STANDARD", True, CIRCLE_COLOR)
        lbl_div = font.render(" [2] OSU DIVA STYLE", True, DIVA_COLOR)
        screen.blit(lbl_std, (140, 300))
        screen.blit(lbl_div, (460, 300))
        
        hint = sub_font.render("Press key [1] or [2] to select your mode style", True, TEXT_COLOR)
        screen.blit(hint, (SCREEN_WIDTH // 2 - hint.get_width() // 2, 480))
        
        for event in pygame.event.get():
            if event.type == pygame.QUIT: running = False
            elif event.type == pygame.KEYDOWN:
                if event.key == pygame.K_1:
                    game_mode = "STANDARD"
                    game_state = "MENU"
                elif event.key == pygame.K_2:
                    game_mode = "DIVA"
                    game_state = "MENU"

    # ==========================================================================
    # 3. STATE: MAIN MENU
    # ==========================================================================
    elif game_state == "MENU":
        screen.fill(MENU_BG)
        
        for event in pygame.event.get():
            if event.type == pygame.QUIT: running = False
            elif event.type == pygame.KEYDOWN:
                if event.key == pygame.K_RETURN:
                    score, combo = 0, 0
                    circles.clear()
                    game_state = "PLAYING"
                elif event.key == pygame.K_s: game_state = "SETTINGS"
                elif event.key == pygame.K_BACKSPACE: game_state = "MODE_SELECT"

        title_text = title_font.render("UCUP OFS", True, CIRCLE_COLOR if game_mode == "STANDARD" else DIVA_COLOR)
        active_mode_str = f"Active Style: Osu! {game_mode.capitalize()}"
        desc_text = font.render(active_mode_str, True, TEXT_COLOR)
        start_text = font.render("PRESS ENTER TO PLAY", True, ACCENT_COLOR)
        settings_hint = font.render("PRESS [S] FOR SETTINGS  |  [BACKSPACE] TO CHANGE MODE", True, TEXT_COLOR)

        screen.blit(title_text, (SCREEN_WIDTH // 2 - title_text.get_width() // 2, 120))
        screen.blit(desc_text, (SCREEN_WIDTH // 2 - desc_text.get_width() // 2, 210))
        screen.blit(start_text, (SCREEN_WIDTH // 2 - start_text.get_width() // 2, 320))
